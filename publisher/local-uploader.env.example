# Copy this file beside xrw-local-uploader.exe as local-uploader.env.
# Keep it local: it contains secrets and is ignored by Git.

TG_BOT_TOKEN=replace-with-your-bot-token
TG_CHAT_IDS=-1001234567890
TG_API_BASE=https://api.telegram.org

# Go uses proxy environment variables, not Windows/browser proxy settings.
# Uncomment and set the HTTP/mixed port of your local proxy when needed.
# HTTPS_PROXY=http://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1,::1

# Must match the secret configured in the standalone gimg Worker.
GIMG_PUBLIC_BASE=https://gimg.example.com
GIMG_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Local limits and pacing. Files are uploaded as Telegram documents.
MAX_IMAGE_MB=20
TG_UPLOAD_INTERVAL=3500ms
TG_GLOBAL_INTERVAL=500ms
TG_MAX_CONCURRENT=1

# Optional. Defaults to folders beside the executable, so C: is not used
# when the executable is kept on D:.
LOCAL_UPLOADER_ADDR=127.0.0.1:8765
LOCAL_UPLOADER_DATA_DIR=
LOCAL_SNAPSHOT_DIR=

# Existing xrw-album checkout. Git Credential Manager supplies GitHub login;
# no GitHub token is stored in this file. Set it to off/none/- to keep the
# snapshots on disk without pushing them (the phone build has no checkout).
LOCAL_GIT_REPOSITORY=

# Optional gallery-site browser. Point these at the WordPress sites whose
# published galleries you want to browse inside the uploader page; covers are
# hot-linked from those origins, only the galleries you tick are downloaded.
# Set either variable to off/none/- to hide the region entirely.

# One line, sites separated by commas. Each site is written as `url`, `id|url`,
# `id|name|url` or `id|name|url|image-source`. The id names the cache directory
# and the URL parameter, so keep it short and stable; without one it is derived
# from the host. This takes precedence over XRW_WP_BASE when both are set.
#
# The image source is `media` by default, which reads a gallery from the media
# endpoint (cosplaytele.com). Use `content` for a site that only puts the cover
# there and keeps the set in the post body (misskon.com), or `acgmhn` for a site
# with no API at all whose galleries are paginated HTML (acgmhn.com).
# XRW_WP_SITES=https://cosplaytele.com
# XRW_WP_SITES=cosplaytele|https://cosplaytele.com
# XRW_WP_SITES=cosplaytele|Cosplaytele|https://cosplaytele.com
# XRW_WP_SITES=cosplaytele|Cosplaytele|https://cosplaytele.com,mirror|Mirror|https://mirror.example.com
# XRW_WP_SITES=cosplaytele|Cosplaytele|https://cosplaytele.com,misskon|MissKon|https://misskon.com|content
# XRW_WP_SITES=cosplaytele|Cosplaytele|https://cosplaytele.com,misskon|MissKon|https://misskon.com|content,acgmhn|Acgmhn|https://www.acgmhn.com|acgmhn

# The single-site form, still supported. A second site on the same host is fine:
# it just needs its own id.
XRW_WP_BASE=https://cosplaytele.com
XRW_WP_REFRESH=6h
