[Unit]
Description=XRW album VPS publisher
After=network-online.target sing-box.service
Wants=network-online.target
Requires=sing-box.service

[Service]
Type=simple
User=xrw-publisher
Group=xrw-publisher
WorkingDirectory=/opt/xrw-publisher
EnvironmentFile=/etc/xrw-publisher.env
ExecStart=/opt/xrw-publisher/xrw-publisher daemon -pages 5 -batch 0
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xrw-publisher

[Install]
WantedBy=multi-user.target
