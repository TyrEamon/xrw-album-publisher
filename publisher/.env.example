# Veil API. Each proxy has its own 80/300s pacing bucket.
VEIL_BASE_URL=https://veil.ortlinde.com
VEIL_PROXIES=socks5://127.0.0.1:10801,socks5://127.0.0.1:10802
VEIL_REQUESTS_PER_WINDOW=80
VEIL_WINDOW=300s
VEIL_COOLDOWN=35m

# Persistent VPS state.
PUBLISHER_DB=/var/lib/xrw-publisher/publisher.db
PUBLISHER_WORK_DIR=/var/lib/xrw-publisher/work
GALLERY_WORKERS=6
GALLERY_MAX_RETRIES=5
DISCOVERY_INTERVAL=15m
MAX_IMAGE_MB=20

# The VPS uploads original files to a Telegram Channel in groups of up to 10.
TG_BOT_TOKEN=123456:replace-me
TG_CHAT_IDS=-1001234567890,-1001234567891
TG_API_BASE=https://api.telegram.org
# Interval between media-group API requests, not between individual files.
TG_UPLOAD_INTERVAL=3500ms
TG_GLOBAL_INTERVAL=500ms
TG_MAX_CONCURRENT=3

# Public image route served by the xrw-album Worker from D1 tg_files mappings.
IMAGE_PUBLIC_BASE=https://album.example.com

# GitHub Pages snapshots use the standalone, D1-free gimg Worker. Keep this
# secret identical to the GIMG_SIGNING_SECRET stored in that Worker.
GIMG_PUBLIC_BASE=https://gimg.example.com
GIMG_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Optional xrw-album private publishing API. Without it, completed albums stay in work/outbox.
XRW_ADMIN_URL=https://album.example.com/api/admin/sync
XRW_ADMIN_TOKEN=replace-me

# Independent migration of the original linuxdo-85w Telegraph archive.
LEGACY_DB=/var/lib/xrw-publisher/legacy.db
LEGACY_SOURCE=/var/lib/xrw-publisher/linuxdo-85w.txt
LEGACY_WORK_DIR=/var/lib/xrw-publisher/legacy-work
LEGACY_WORKERS=3
LEGACY_SOURCE_RETRIES=3
LEGACY_RETRY_DELAY=30m
