# 绮影志本地上传器 · 手机版配置
#
# 这个文件在首次启动时从 APK 复制出来，也可以从 App 的「配置」按钮里改。
# 改完点「保存并重启」就会生效。
#
# 必填三项：TG_BOT_TOKEN、TG_CHAT_IDS，以及和图片 Worker 一致的
# GIMG_SIGNING_SECRET（GIMG_PUBLIC_BASE 已经填好）。
# 最省事：把电脑上的 publisher/bin/local-uploader.env 拷到手机上，用
# 「配置 → 从文件导入」导入——里面的 Windows 路径会被 App 忽略。

TG_BOT_TOKEN=
TG_CHAT_IDS=

# 代理：一般不用写。App 启动上传器时会去读手机当前的代理设置（v2rayNG 的
# 「系统代理」、VPN 自带的 HTTP 代理、Wi-Fi 代理），有就自动塞给上传器，所以
# 不用把端口写死在这里；手机是 VPN（TUN）模式、没有代理设置时就直接连。
# 只有"手机有代理但没告诉系统"时才需要在下面手写一行，例如：
#   HTTPS_PROXY=http://127.0.0.1:10808
# 三个图源站和 Telegram 在国内都得走代理才能连上。
NO_PROXY=localhost,127.0.0.1,::1

TG_API_BASE=https://api.telegram.org
GIMG_PUBLIC_BASE=https://gimg.mtcacg.top
MAX_IMAGE_MB=20
TG_UPLOAD_INTERVAL=3500ms
TG_GLOBAL_INTERVAL=500ms
TG_MAX_CONCURRENT=1

# 站点图包：id|名字|网址|取图方式（media / content / acgmhn）
XRW_WP_SITES=cosplaytele-com|Cosplaytele|https://cosplaytele.com,misskon|MissKon|https://misskon.com|content,acgmhn|ACG写真|https://www.acgmhn.com|acgmhn
XRW_WP_REFRESH=6h

# 下面几个由 App 写死在子进程环境里，写在文件里也不会生效：
#   LOCAL_UPLOADER_ADDR / LOCAL_UPLOADER_DATA_DIR / LOCAL_SNAPSHOT_DIR
#   LOCAL_GIT_REPOSITORY=off
#   LOCAL_UPLOADER_DISABLE=telegram-import（手机上没有浏览器扩展跑油猴脚本）
# 手机上的快照只落在 App 私有目录里，推送快照分支仍然在电脑上做。
